diff --git a/meson.build b/meson.build
index 164328ded8..5fcda08b14 100644
--- a/meson.build
+++ b/meson.build
@@ -4393,6 +4393,29 @@ foreach target : target_dirs
                  c_args: c_args,
                  build_by_default: false)
 
+  # gem5's RISC-V JitCPU embeds the TCG system emulator behind a small C ABI.
+  # Keep this target RISC-V-only and do not expose QEMU headers to gem5.
+  if target == 'riscv64-softmmu' and get_option('gem5_jit_dir') != ''
+    gem5_jit_dir = get_option('gem5_jit_dir')
+    gem5_jit_lib = shared_library(
+      'gem5-qemu-jit', files(gem5_jit_dir / 'qemu-jit.c'),
+      name_prefix: 'lib',
+      install: false,
+      build_by_default: false,
+      c_args: c_args,
+      dependencies: arch_deps + [target_stubs],
+      objects: lib.extract_all_objects(recursive: true),
+      link_depends: [block_syms, qemu_syms],
+      link_args: link_args)
+    gem5_jit_smoke = executable(
+      'gem5-qemu-jit-smoke', files(gem5_jit_dir / 'qemu-jit-smoke.c'),
+      link_with: gem5_jit_lib,
+      install: false,
+      build_by_default: false)
+    test('gem5-qemu-jit-smoke', gem5_jit_smoke,
+         suite: ['unit', 'gem5-jit'])
+  endif
+
   if target.endswith('-softmmu')
     execs = [{
       'name': 'qemu-system-' + target_name,
