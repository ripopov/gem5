# -*- mode:python -*-
# AI-generated by Codex/Claude.

from gem5_scons import warning

import gem5_scons

Import("env")

env["HAVE_FTR_TRACE"] = False

with gem5_scons.Configure(env) as conf:
    if not conf.CheckLibWithHeader(
            "lz4", "lz4.h", "C++", call="LZ4_versionNumber();"):
        warning("ext/ftr_trace is present but liblz4 and/or lz4.h were not "
                "found. Disabling ftr_trace integration.")
        Return()

env.Prepend(CPPPATH=Dir("./include").srcnode())
env["HAVE_FTR_TRACE"] = True
