        <mxCell id="nl" value="&lt;b&gt;NetworkLink&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(ClockedObject + Consumer)&lt;br&gt;&lt;br&gt;m_latency cycles&lt;br&gt;flitBuffer linkBuffer&lt;br&gt;setLinkConsumer(NI|Router)&lt;br&gt;wakeup(): peek linkBuffer →&lt;br&gt;&amp;nbsp;&amp;nbsp;schedule consumer&lt;br&gt;mVnets[] — allowed vnets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e3ea3;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="35" y="755" width="300" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="cl" value="&lt;b&gt;CreditLink&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(subclass of NetworkLink)&lt;br&gt;&lt;br&gt;carries Credit objects&lt;br&gt;per-VC back-pressure&lt;br&gt;&lt;br&gt;&lt;b&gt;Credit&lt;/b&gt; : flit&lt;br&gt;&amp;nbsp;&amp;nbsp;m_vc,&lt;br&gt;&amp;nbsp;&amp;nbsp;m_is_free_signal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e3ea3;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="350" y="755" width="290" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="nb" value="&lt;b&gt;NetworkBridge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(extends CreditLink)&lt;br&gt;&lt;br&gt;HeteroGarnet glue; optional.&lt;br&gt;&lt;b&gt;enCdc&lt;/b&gt;: clock-domain crossing&lt;br&gt;&lt;b&gt;enSerDes&lt;/b&gt;: serializer/deserializer&lt;br&gt;(links of different bit widths)&lt;br&gt;flitisizeAndSend(flit)&lt;br&gt;neutralize(vc, eCredit) — credit fixup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e3ea3;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="655" y="755" width="330" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="flit" value="&lt;b&gt;flit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(Message payload carrier)&lt;br&gt;&lt;br&gt;m_packet_id, m_id, m_vnet, m_vc&lt;br&gt;m_type: HEAD/BODY/TAIL/HEAD_TAIL/CREDIT&lt;br&gt;m_stage: (flit_stage, Tick)&lt;br&gt;RouteInfo m_route (src/dst router+ni)&lt;br&gt;MsgPtr m_msg_ptr (shared)&lt;br&gt;m_size, m_width, m_enqueue/dequeue_time&lt;br&gt;serialize / deserialize (SerDes)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e3ea3;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="755" width="320" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="flitbuf" value="&lt;b&gt;flitBuffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;priority_queue&amp;lt;flit*&amp;gt; by time&lt;br&gt;isReady(tick): any flit due?&lt;br&gt;getTopFlit() / peekTopFlit()&lt;br&gt;&lt;br&gt;used inside:&lt;br&gt;&amp;nbsp;&amp;nbsp;VirtualChannel, CrossbarSwitch,&lt;br&gt;&amp;nbsp;&amp;nbsp;NetworkLink, NI (niOutVcs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e3ea3;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1335" y="755" width="320" height="175" as="geometry"/>
        </mxCell>

        <!-- Per-cycle flow legend -->
        <mxCell id="leg_frame" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="960" width="1660" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="leg_title" value="&lt;b&gt;Per-cycle flow (one hop, no contention)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="35" y="968" width="400" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_flow" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Protocol controller enqueues MsgPtr on MessageBuffer (outbound vnet).&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; NI::wakeup() dequeues; flitisizeMessage() chops msg into HEAD/BODY/TAIL flits sized m_ni_flit_size; calculateVC(vnet) picks a VC.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Flits pushed into niOutVcs[vc]; scheduleOutputLink() moves one flit/cycle to OutputPort.outFlitQueue → NetworkLink.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; NetworkLink::wakeup() delays flit by m_latency cycles, then schedules Router::wakeup() at the next hop.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Router::wakeup() → InputUnit::wakeup(): for HEAD, RoutingUnit::outportCompute() writes outport into VirtualChannel.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Flit buffered for (m_latency−1) cycles; then SwitchAllocator::wakeup() runs SA-I (inport RR) and SA-II (outport RR); allocates outvc for HEAD.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Winning flit passes through CrossbarSwitch into OutputUnit.outBuffer; decrement_credit; InputUnit sends Credit to upstream on CreditLink.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; GarnetIntLink delivers flit to next router&#39;s InputUnit; on final hop an ExtLink drops it into the destination NI.InputPort.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; At destination NI::wakeup(): accumulate flits by packet_id; on TAIL, enqueue original MsgPtr into outNode_ptr[vnet] → protocol controller.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="35" y="992" width="1620" height="165" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
