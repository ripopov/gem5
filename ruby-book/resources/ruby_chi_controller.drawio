          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_rspIn_fsm" style="endArrow=classic;html=1;strokeColor=#15803d;strokeWidth=2;" edge="1" parent="1" source="rspIn" target="fsm_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_datIn_fsm" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="1" source="datIn" target="fsm_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FSM -> outbound network -->
        <mxCell id="e_fsm_reqOut" style="endArrow=classic;html=1;strokeColor=#1d4ed8;strokeWidth=2;" edge="1" parent="1" source="fsm_box" target="reqOut">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="952" y="350" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_fsm_snpOut" style="endArrow=classic;html=1;strokeColor=#c58b1b;strokeWidth=2;" edge="1" parent="1" source="fsm_box" target="snpOut">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fsm_rspOut" style="endArrow=classic;html=1;strokeColor=#15803d;strokeWidth=2;" edge="1" parent="1" source="fsm_box" target="rspOut">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_fsm_datOut" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="1" source="fsm_box" target="datOut">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FSM <-> TBE storage -->
        <mxCell id="e_fsm_tbe" value="alloc / lookup / dealloc" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#c2410c;strokeWidth=2;fontSize=10;fontColor=#c2410c;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="fsm_box" target="tbe_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FSM <-> cache -->
        <mxCell id="e_fsm_cache" value="tag lookup&#10;DataBlk r/w" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;fontSize=10;fontColor=#0f766e;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="fsm_box" target="cache">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- FSM <-> directory (HN only) -->
        <mxCell id="e_fsm_dir" value="sharer filter&#10;(HN only)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#7c3aed;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="fsm_box" target="dir">
