        <!-- Prefetcher -> prefetchQueue -->
        <mxCell id="e_pf_pfq" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="pf" target="pfq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- mandatoryQueue -> FSM (alloc seq TBE) -->
        <mxCell id="e_mand_fsm" value="AllocSeqRequest" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="mand" target="fsm_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- prefetchQueue -> FSM -->
        <mxCell id="e_pfq_fsm" value="AllocPfRequest" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="pfq" target="fsm_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Inbound network -> FSM -->
        <mxCell id="e_reqIn_fsm" style="endArrow=classic;html=1;strokeColor=#1d4ed8;strokeWidth=2;" edge="1" parent="1" source="reqIn" target="fsm_box">
