        <!-- =============================================================== -->

        <!-- Sequencer -> mandatoryQueue -->
        <mxCell id="e_seq_mand" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="seq" target="mand">
          <mxGeometry relative="1" as="geometry"/>
