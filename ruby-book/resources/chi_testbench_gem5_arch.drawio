        <mxCell id="t1" value="&lt;b&gt;Tile 1&lt;/b&gt; · R1&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#64748b&quot;&gt;seq=idle&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#334155&quot;&gt;+HNF 1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2.5;verticalAlign=middle;align=center;fontSize=11;fontColor=#065f46;arcSize=5;" vertex="1" parent="1">
