        <mxCell id="p1_mode_lbl" value="&lt;b&gt;Mode-dependent parameters&lt;/b&gt; &lt;span style=&quot;font-size:11px;color:#7c2d12;font-weight:normal&quot;&gt;— picked by --rn-mode at build time&lt;/span&gt;" style="text;html=1;fontSize=11;fontColor=#7c2d12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="836" y="410" width="488" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="p1_mode_rnfl2" value="&lt;b style=&quot;color:#065f46&quot;&gt;mode = &quot;rnf_l2&quot;&lt;/b&gt; &lt;span style=&quot;font-size:10px;color:#065f46&quot;&gt;(coherent leaf cache)&lt;/span&gt;&lt;div style=&quot;font-size:11px;color:#065f46;font-weight:normal;margin-top:4px;text-align:left;padding:0 6px;line-height:1.45&quot;&gt;cache = 256 KiB, 8-way&lt;br/&gt;alloc_on_seq_acc = True&lt;br/&gt;alloc_on_read{shared,unique,once} = True&lt;br/&gt;alloc_on_writeback = True&lt;br/&gt;allow_SD = True · send_evictions = True&lt;br/&gt;dealloc_backinv_{unique,shared} = True&lt;hr style=&quot;border:0;border-top:1px dashed #065f46;margin:4px 0&quot;/&gt;&lt;b&gt;Wire opcodes&lt;/b&gt;&lt;br/&gt;read → ReadShared / ReadUnique&lt;br/&gt;write → CleanUnique + WriteBackFull&lt;br/&gt;accepts SnpShared / SnpUnique / SnpCleanInv&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;fontSize=12;fontColor=#065f46;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="836" y="430" width="240" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="p1_mode_rni" value="&lt;b style=&quot;color:#9a3412&quot;&gt;mode = &quot;rni&quot;&lt;/b&gt; &lt;span style=&quot;font-size:10px;color:#9a3412&quot;&gt;(cache-less / DMA-like)&lt;/span&gt;&lt;div style=&quot;font-size:11px;color:#9a3412;font-weight:normal;margin-top:4px;text-align:left;padding:0 6px;line-height:1.45&quot;&gt;cache = 128 B dummy, 1-way&lt;br/&gt;alloc_on_seq_acc = False&lt;br/&gt;alloc_on_read{shared,unique,once} = False&lt;br/&gt;alloc_on_writeback = False&lt;br/&gt;allow_SD = False · send_evictions = False&lt;br/&gt;dealloc_backinv_{unique,shared} = False&lt;hr style=&quot;border:0;border-top:1px dashed #9a3412;margin:4px 0&quot;/&gt;&lt;b&gt;Wire opcodes&lt;/b&gt;&lt;br/&gt;read → ReadOnce / ReadOnceCleanInvalid&lt;br/&gt;write → WriteNoSnpFull&lt;br/&gt;never snooped (not a sharing RN)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#ea580c;strokeWidth=2;verticalAlign=top;fontSize=12;fontColor=#9a3412;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1084" y="430" width="240" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="p1_router" value="&lt;b&gt;Mesh router (Garnet)&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;font-weight:normal;margin-top:3px&quot;&gt;direct ExtLink from controller · no intermediate &amp;quot;node router&amp;quot;&lt;br/&gt;(CustomMesh isinstance branch for CHI_RNF is skipped)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#334155;strokeWidth=2;verticalAlign=top;fontSize=13;fontColor=#0f172a;arcSize=4;" vertex="1" parent="1">
