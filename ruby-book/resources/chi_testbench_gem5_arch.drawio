        <!-- 4x4 grid of tile cards, each at (col * 320 + 50, row * 180 + 1110) -->
        <!-- ROW 0 -->
        <mxCell id="t0" value="&lt;b&gt;Tile 0&lt;/b&gt; · R0&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;seq=&lt;b&gt;ping_pong&lt;/b&gt; (role A)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#334155&quot;&gt;+HNF 0 +SNF 0 +MN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2.5;verticalAlign=middle;align=center;fontSize=11;fontColor=#065f46;arcSize=5;" vertex="1" parent="1">
