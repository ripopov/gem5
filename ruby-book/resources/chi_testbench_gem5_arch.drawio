  <diagram name="chi_testbench_gem5 architecture" id="chi-tb-gem5-arch">
    <mxGraphModel dx="1400" dy="1900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1900" math="0" shadow="0" background="#ffffff">
      <root>
