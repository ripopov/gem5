        <mxCell id="p1_seq_in" value="&lt;b&gt;RubySequencer&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#115e59;font-weight:normal;margin-top:4px;text-align:left;padding:0 8px;line-height:1.5&quot;&gt;in_ports (slave)   ← DataPort&lt;br/&gt;out_ports (master) → recvTimingResp&lt;br/&gt;mandatoryQueue · coalescedTable · deadlock watchdog&lt;br/&gt;&lt;span style=&quot;color:#4a044e&quot;&gt;note: MemCmd::ReadReq and ReadExReq both→ RubyRequestType_LD&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0f766e;strokeWidth=1.5;verticalAlign=top;fontSize=12;fontColor=#115e59;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="520" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p1_ctrl" value="&lt;b style=&quot;color:#7c2d12&quot;&gt;CHI_TileCacheController&lt;/b&gt;  &lt;span style=&quot;font-size:11px;color:#7c2d12;font-weight:normal&quot;&gt;— Base_CHI_Cache_Controller&lt;/span&gt;&lt;div style=&quot;font-size:11px;color:#7c2d12;font-weight:normal;margin-top:2px&quot;&gt;shared SLICC automaton (CHI_Cache_Controller.sm) · is_HN=False · DMT/DCT disabled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#c58b1b;strokeWidth=2.5;verticalAlign=top;fontSize=13;fontColor=#7c2d12;arcSize=3;" vertex="1" parent="1">
