        <!-- ============================================================== -->
        <!--  PANEL 1 — SINGLE TILE DEEP DIVE                                -->
        <!-- ============================================================== -->
        <mxCell id="p1_title" value="&lt;b style=&quot;font-size:17px&quot;&gt;Panel 1 — Single tile architecture&lt;/b&gt; &lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;system.cpu[i] (gem5 side) ↔ system.ruby.rnf[i] (Ruby side)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1360" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p1_frame" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1360" height="860" as="geometry"/>
        </mxCell>

        <!-- LEFT — gem5 domain (ChiSeqDriver) -->
        <mxCell id="p1_gem5_frame" value="&lt;b style=&quot;color:#1e3a8a&quot;&gt;gem5 domain — ChiSeqDriver (ClockedObject)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;fontSize=13;fontColor=#1e3a8a;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="560" height="810" as="geometry"/>
        </mxCell>

        <mxCell id="p1_params" value="&lt;b&gt;Python params (SimObject)&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#1e3a8a;font-weight:normal;margin-top:4px;text-align:left;padding:0 8px;&quot;&gt;sequence = &quot;ping_pong&quot; / &quot;opcode_walk&quot; / ...&lt;br/&gt;tile_id, addresses[], iterations, access_size&lt;br/&gt;target_addr, filler_base, filler_lines&lt;br/&gt;line_addr, byte_offset, pipeline_depth&lt;br/&gt;role, wait_event_name, post_event_name&lt;br/&gt;finish_barrier → ChiGem5Barrier (shared)&lt;br/&gt;event_bus      → ChiGem5EventBus (shared)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1d4ed8;strokeWidth=1.2;verticalAlign=top;fontSize=12;fontColor=#1e3a8a;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="520" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p1_fiber_box" value="&lt;b style=&quot;color:#6d28d9&quot;&gt;SeqThread : gem5::Fiber&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#6d28d9;font-weight:normal;margin-top:2px&quot;&gt;stack-switched coroutine&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7c3aed;strokeWidth=2;verticalAlign=top;fontSize=13;fontColor=#4c1d95;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="520" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="p1_seq_body" value="&lt;b&gt;sequence body (C++ fn resolved by SequenceRegistry)&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;font-weight:normal;margin-top:4px;text-align:left;padding:0 8px;&quot;&gt;void my_seq(SequenceContext&amp;amp;) { ... }&lt;br/&gt;// issues reads/writes, yields on blocking calls,&lt;br/&gt;// wakes on responses or rendezvous notifications&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7c3aed;strokeWidth=1.2;verticalAlign=top;fontSize=12;fontColor=#334155;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="78" y="330" width="484" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p1_api_label" value="&lt;b&gt;API surface the sequence calls&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#4c1d95;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="78" y="405" width="484" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="p1_api_block" value="&lt;div style=&quot;font-size:11px;color:#4c1d95;font-weight:normal;text-align:left;padding:6px 10px;line-height:1.5&quot;&gt;&lt;b&gt;Blocking&lt;/b&gt;: read() · write() · read_exclusive()&lt;br/&gt;&lt;b&gt;Non-blocking&lt;/b&gt;: async_read{_exclusive}() · async_write() · resolve(h) · resolve_all()&lt;br/&gt;&lt;b&gt;Time / sync&lt;/b&gt;: wait_ticks() · wait_on(name) · notify(name) · barrier.signal_finish()&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7c3aed;strokeWidth=1.2;verticalAlign=top;fontSize=12;fontColor=#4c1d95;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="78" y="425" width="484" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="p1_events_box" value="&lt;b&gt;Event callbacks (on gem5 EventQueue)&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;font-weight:normal;margin-top:4px;text-align:left;padding:0 8px;line-height:1.5&quot;&gt;&lt;b&gt;recvTimingResp&lt;/b&gt;(pkt) → seq_thread.run()  // response wakes fiber&lt;br/&gt;&lt;b&gt;kickEvent&lt;/b&gt;              → seq_thread.run()  // first entry into fiber&lt;br/&gt;&lt;b&gt;xfer_wake&lt;/b&gt; (0-tick)    → seq_thread.run()  // cross-fiber handoff&lt;br/&gt;&lt;b&gt;wait_event&lt;/b&gt;           → seq_thread.run()  // wait_ticks timer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#c58b1b;strokeWidth=1.5;verticalAlign=top;fontSize=12;fontColor=#7c2d12;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="520" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="p1_dataport" value="&lt;b&gt;DataPort : RequestPort&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#334155;font-weight:normal;margin-top:3px&quot;&gt;sendTimingReq(Packet*) &amp;nbsp;·&amp;nbsp; recvTimingResp() &amp;nbsp;·&amp;nbsp; recvReqRetry()&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369a1;strokeWidth=2;verticalAlign=top;fontSize=13;fontColor=#0c4a6e;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="520" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p1_sync_note" value="&lt;b&gt;Shared sync objects&lt;/b&gt; (same Python instance wired into every driver)&lt;div style=&quot;font-size:11px;color:#334155;font-weight:normal;margin-top:4px;text-align:left;padding:0 8px&quot;&gt;ChiGem5Barrier   — counter-based, last signal_finish() calls exitSimLoop()&lt;br/&gt;ChiGem5EventBus  — named-Latch registry; wait_on(&amp;quot;foo&amp;quot;) / notify(&amp;quot;foo&amp;quot;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7c3aed;strokeWidth=1.2;dashed=1;verticalAlign=top;fontSize=12;fontColor=#4c1d95;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="520" height="110" as="geometry"/>
        </mxCell>

        <!-- CENTER — Packet flow arrows -->
        <mxCell id="p1_center_req" value="" style="endArrow=classic;html=1;strokeColor=#1d4ed8;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_dataport" target="p1_seq_in">
