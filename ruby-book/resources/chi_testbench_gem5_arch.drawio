        </mxCell>

        <!-- RIGHT — Ruby/CHI domain -->
        <mxCell id="p1_ruby_frame" value="&lt;b style=&quot;color:#0f766e&quot;&gt;Ruby/CHI domain — system.ruby.rnf[i] = CHI_Tile&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0f766e;strokeWidth=2;verticalAlign=top;fontSize=13;fontColor=#115e59;arcSize=3;" vertex="1" parent="1">
