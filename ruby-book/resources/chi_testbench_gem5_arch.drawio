        <mxCell id="p1_center_resp" value="" style="endArrow=classic;html=1;strokeColor=#be123c;strokeWidth=2.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="p1_seq_in" target="p1_dataport">
