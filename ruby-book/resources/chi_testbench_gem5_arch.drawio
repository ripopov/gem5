          <mxGeometry x="836" y="315" width="488" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="p1_cache_box" value="&lt;b&gt;cache : RubyCache&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#115e59;font-weight:normal;margin-top:2px&quot;&gt;mode-sized (see cards below)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0f766e;strokeWidth=1.2;verticalAlign=middle;align=center;fontSize=12;fontColor=#115e59;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="836" y="335" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p1_tbe_box" value="&lt;b&gt;TBE pools&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#7c2d12;font-weight:normal;margin-top:2px;text-align:left;padding:0 8px;line-height:1.4&quot;&gt;request: 32 · snoop: 16 · repl: 16&lt;br/&gt;DVM req/snoop: 1 / 1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#c58b1b;strokeWidth=1.2;verticalAlign=top;fontSize=12;fontColor=#7c2d12;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1084" y="335" width="240" height="60" as="geometry"/>
