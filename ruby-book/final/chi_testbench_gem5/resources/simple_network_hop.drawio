        <mxCell id="routerA_lbl" value="Router A  &amp;#8212;  SimpleNetwork &lt;b&gt;Switch&lt;/b&gt; (BasicRouter)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="297" y="98" width="881" height="22" as="geometry"/></mxCell>
        <mxCell id="routerA_sub" value="one PerfectSwitch + one Throttle &amp; one port buffer per (output port × vnet) · diagram shows a single vnet" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=10;fontColor=#6a4f86;" vertex="1" parent="1"><mxGeometry x="297" y="120" width="881" height="18" as="geometry"/></mxCell>
        <mxCell id="port_in_hdr" value="&lt;b&gt;&amp;#9660; INPUT side (into PerfectSwitch)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=10;fontColor=#6a4f86;" vertex="1" parent="1"><mxGeometry x="303" y="150" width="230" height="16" as="geometry"/></mxCell>
        <mxCell id="note_extin" value="&lt;b&gt;No router-side RN-F input buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:8px&#x27;&gt;PerfectSwitch reads the controller&#x27;s output buffer&lt;br&gt;directly &amp;#8212; m_toNetQueues &lt;i&gt;is&lt;/i&gt; the switch input queue.&lt;br&gt;One shared object, no copy and no link latency.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;strokeWidth=1.2;fontSize=9;align=center;verticalAlign=middle;fontColor=#000000;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="172" width="215" height="70" as="geometry"/></mxCell>
        <mxCell id="inA_neigh" value="&lt;b&gt;A input ← neighbor router&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;= SimpleIntLink.m_buffers&lt;br&gt;(also the delayed link buffer)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=10;align=center;verticalAlign=top;fontColor=#000000;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="215" height="115" as="geometry"/></mxCell>
