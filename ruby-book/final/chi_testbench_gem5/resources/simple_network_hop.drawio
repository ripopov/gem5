        <mxCell id="inA_neigh_cap" value="depth = L + 1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="466" width="215" height="16" as="geometry"/></mxCell>
        <mxCell id="ps" value="&lt;b&gt;PerfectSwitch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;routing logic · &lt;b&gt;no storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;for each ready input msg:&lt;br&gt;• route() → output port(s)&lt;br&gt;• check areNSlotsAvailable(1)&lt;br&gt;  on output buffer (backpressure)&lt;br&gt;• enqueue into output buffer&lt;br&gt;&lt;br&gt;&lt;b&gt;no crossbar bw limit:&lt;/b&gt;&lt;br&gt;many msgs/cycle into one&lt;br&gt;output buffer (bounded only&lt;br&gt;by its 8 free slots)&lt;/font&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="575" y="240" width="205" height="360" as="geometry"/></mxCell>
