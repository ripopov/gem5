{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "gem5Build",
            "type": "pickString",
            "description": "gem5 build variant",
            "options": [
                "gem5.debug",
                "gem5.opt"
            ],
            "default": "gem5.debug"
        }
    ],
    "configurations": [
        {
            "name": "gem5: ch01-linear",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/ch01-linear",
                "tests/gem5/traffic_gen/configs/simple_traffic_run.py",
                "LinearGenerator",
                "1",
                "NoCache",
                "gem5.components.memory",
                "SingleChannelDDR4_2400",
                "1GiB"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch01-random",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/ch01-random",
                "tests/gem5/traffic_gen/configs/simple_traffic_run.py",
                "RandomGenerator",
                "1",
                "NoCache",
                "gem5.components.memory",
                "SingleChannelDDR4_2400",
                "1GiB"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch05-mi-example-traffic",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/ch05-mi-example-traffic",
                "--debug-flags=ProtocolTrace",
                "--debug-file=protocol_trace.log",
                "tests/gem5/traffic_gen/configs/simple_traffic_run.py",
                "LinearGenerator",
                "1",
                "MIExample",
                "gem5.components.memory",
                "SingleChannelDDR3_1600",
                "512MiB"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch05b-msi-two-cpu",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/msi-test",
                "configs/learning_gem5/part3/riscv/simple_ruby_riscv.py"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch05b-msi-two-cpu (ProtocolTrace)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/msi-trace",
                "--debug-flags=ProtocolTrace",
                "--debug-file=trace.txt",
                "configs/learning_gem5/part3/riscv/simple_ruby_riscv.py"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch17-trivial (4x4 CHI mesh)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/ch17-trivial",
                "configs/example/rbook_mesh_config.py",
                "--cmd=ruby-book/final/trivial"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch17-smoke (4x4 CHI mesh)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/ch17-smoke",
                "configs/example/rbook_mesh_config.py",
                "--cmd=ruby-book/final/smoke/rbook_test_smoke"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ],
            "postDebugTask": "ch17: check smoke stats"
        },
        {
            "name": "gem5: ch17-trivial-ftr (4x4 CHI mesh, FTR dump)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/trivial-ftr",
                "configs/example/rbook_mesh_config.py",
                "--cmd=ruby-book/final/trivial",
                "--trace-output=trivial",
                "--trace-format=ftr"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "text": "handle SIGSEGV nostop noprint pass",
                    "description": "gem5 uses SIGSEGV for null checks"
                }
            ]
        },
        {
            "name": "gem5: ch17-trivial-ftr (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/RISCV/${input:gem5Build}",
            "args": [
                "-d",
                "m5out/trivial-ftr",
                "configs/example/rbook_mesh_config.py",
                "--cmd=ruby-book/final/trivial",
                "--trace-output=trivial",
                "--trace-format=ftr"
            ],
            "cwd": "${workspaceFolder}",
            "preRunCommands": [
                "process handle SIGSEGV -n false -p true -s false"
            ]
        }
    ]
}
