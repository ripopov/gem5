import sys

Import('*')

# USE_JITCPU depends on USE_RISCV_ISA, so the ISA needs no separate guard.
if not env['CONF']['USE_JITCPU']:
    Return()

qemu_jit_dir = Dir('#ext/qemu/repo/contrib/gem5-jit')
qemu_jit_header = qemu_jit_dir.File('qemu-jit.h')
if not qemu_jit_header.exists():
    raise ValueError(
        'USE_JITCPU requires the QEMU submodule; run '
        '`git submodule update --init ext/qemu/repo`'
    )
env.Prepend(CPPPATH=[qemu_jit_dir])

env.TagImplies('jitcpu', 'gem5 lib')
env.TagImplies('jitcpu', 'riscv isa')

SimObject('RiscvJitCPU.py', sim_objects=['RiscvJitCPU'], tags=['jitcpu'])
Source('riscv_jit_cpu.cc', tags=['jitcpu'])

DebugFlag('JitCPU', 'RISC-V QEMU/TCG JitCPU execution', tags=['jitcpu'])

# dlopen(3) is part of libc on macOS and on glibc 2.34 and newer, but older
# glibc keeps it in a separate library which must be requested explicitly.
if sys.platform != 'darwin':
    env.Append(LIBS=['dl'])
