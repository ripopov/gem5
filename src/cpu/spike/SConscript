import sys

Import('*')

# USE_SPIKECPU depends on USE_RISCV_ISA, so the ISA needs no separate guard.
if not env['CONF']['USE_SPIKECPU']:
    Return()

spike_dir = Dir('#ext/spike/gem5-spike')
env.Prepend(CPPPATH=[spike_dir])

env.TagImplies('spikecpu', 'gem5 lib')
env.TagImplies('spikecpu', 'riscv isa')

SimObject('RiscvSpikeCPU.py', sim_objects=['RiscvSpikeCPU'],
          tags=['spikecpu'])
Source('riscv_spike_cpu.cc', tags=['spikecpu'])

# dlopen(3) is part of libc on macOS and on glibc 2.34 and newer, but older
# glibc keeps it in a separate library which must be requested explicitly.
if sys.platform != 'darwin':
    env.Append(LIBS=['dl'])
